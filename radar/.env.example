# Copy to radar/.env and fill in. Never commit the real file.

# AssemblyAI — https://www.assemblyai.com/app/account
ASSEMBLYAI_API_KEY=

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# SQLite database location (relative paths resolve from radar/).
DATABASE_URL="file:./data/radar.db"

# AssemblyAI billing rate, USD per audio hour. Used only for estCostUsd
# estimates; reconcile against the AssemblyAI dashboard after the first runs.
RATE_PER_HOUR=0.17

# Naming model. Verified against docs.claude.com during Phase 2.
NAMING_MODEL=claude-haiku-4-5-20251001
